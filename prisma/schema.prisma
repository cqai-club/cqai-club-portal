generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MemberApplication {
  id                      String   @id @default(uuid())
  name                    String
  phone                   String   @unique
  wechat                  String
  email                   String?
  organization            String
  title                   String
  orgType                 String
  orgTypeOther            String?

  provideResources        String   // Storing JSON as string
  provideResourcesOther   String?
  needResources           String   // Storing JSON as string
  needResourcesOther      String?

  joinPurpose             String
  joinPurposeOther        String?
  expectEvents            String   // Storing JSON as string
  expectEventsOther       String?
  timePreference          String

  city                    String
  cityOther               String?
  roleIntent              String
  bio                     String?
  privacyPreference       String

  isHighValue             Boolean  @default(false)

  createdAt               DateTime @default(now())
  ipAddress               String?
}

model CollectionSubmission {
  id          String   @id @default(uuid())
  type        String
  status      String   @default("new")
  displayName String
  contact     String
  phone       String?
  email       String?
  payloadJson String
  consent     Boolean  @default(false)
  consentAt   DateTime?
  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assets      SubmissionAsset[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model SubmissionAsset {
  id           String               @id @default(uuid())
  submissionId String
  kind         String
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime             @default(now())
  submission   CollectionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}
