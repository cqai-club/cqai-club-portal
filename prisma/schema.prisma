generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MemberResource {
  id              String   @id @default(uuid())
  description     String
  externalUrl     String
  imageStorageKey String
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, createdAt])
}

model MemberOrganizationBinding {
  id             String   @id @default(uuid())
  name           String
  organizationId String   @unique
  organizationName String?
  validatedAt    DateTime?
  revision       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MemberOrganizationJoin {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  actorIssuer    String
  actorSub       String
  source         String
  confirmedAt    DateTime @default(now())

  @@unique([organizationId, userId])
}

model MemberApplication {
  id                      String   @id @default(uuid())
  userIssuer              String?
  userSub                 String?
  name                    String
  phone                   String   @unique
  wechat                  String
  email                   String?
  organization            String
  title                   String
  orgType                 String
  orgTypeOther            String?

  provideResources        String   // Storing JSON as string
  provideResourcesOther   String?
  needResources           String   // Storing JSON as string
  needResourcesOther      String?

  joinPurpose             String
  joinPurposeOther        String?
  expectEvents            String   // Storing JSON as string
  expectEventsOther       String?
  timePreference          String

  city                    String
  cityOther               String?
  roleIntent              String
  bio                     String?
  privacyPreference       String

  isHighValue             Boolean  @default(false)
  reviewStatus            String   @default("pending")
  reviewNote              String?
  reviewedByIssuer        String?
  reviewedBySub           String?
  reviewedAt              DateTime?
  membershipState         String   @default("none")
  membershipOrganizationId String?
  membershipAttemptId     String?
  membershipStartedAt     DateTime?
  membershipError         String?

  createdAt               DateTime @default(now())
  ipAddress               String?

  @@unique([userIssuer, userSub])
}

model CollectionSubmission {
  id              String   @id @default(uuid())
  userIssuer      String?
  userSub         String?
  type            String
  status          String   @default("new")
  displayName     String
  contact         String
  phone           String?
  email           String?
  payloadJson     String
  consent         Boolean  @default(false)
  consentAt       DateTime?
  ipAddress       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assets          SubmissionAsset[]
  importedProject Project?

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([userIssuer, userSub, type, createdAt])
}

model SubmissionAsset {
  id           String               @id @default(uuid())
  submissionId String
  kind         String
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime             @default(now())
  submission   CollectionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Plugin {
  id                        String   @id @default(uuid())
  status                    String   @default("draft")
  packageName               String   @unique
  displayName               String
  summary                   String
  description               String?
  categoriesJson            String   @default("[]")
  keywordsJson              String   @default("[]")
  repositoryUrl             String?
  homepageUrl               String?
  iconUrl                   String?
  compatibilityApiVersion  String?
  compatibilityHostsJson   String   @default("[]")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  publishedAt               DateTime?
  submissions               PluginSubmission[]

  @@index([status])
  @@index([updatedAt])
}

model PluginSubmission {
  id                String   @id @default(uuid())
  status            String   @default("pending")
  packageName       String
  payloadJson       String
  submittedByIssuer String
  submittedBySub    String
  submittedByName   String?
  reviewedByIssuer  String?
  reviewedBySub     String?
  reviewNote        String?
  pluginId          String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reviewedAt        DateTime?
  plugin            Plugin?  @relation(fields: [pluginId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([packageName])
  @@index([submittedByIssuer, submittedBySub, createdAt])
}

model Project {
  id                 String                @id @default(uuid())
  sourceSubmissionId String?               @unique
  slug               String                @unique
  status             String                @default("draft")
  name               String
  ownerName          String?
  summary            String
  description        String
  stage              String?
  focus              String?
  collaborationNeeds String?
  demoUrl            String?
  internalContact    String?
  publicContactType  String                @default("club")
  publicContactValue String?
  coverStorageKey    String?
  coverOriginalName  String?
  coverMimeType      String?
  coverSize          Int?
  featured           Boolean               @default(false)
  featuredOrder      Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  publishedAt        DateTime?
  reviewedAt         DateTime?
  reviewedBy         String?
  sourceSubmission   CollectionSubmission? @relation(fields: [sourceSubmissionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([featured, featuredOrder])
  @@index([publishedAt])
}

model ClubActivity {
  id                    String                     @id @default(uuid())
  title                 String
  summary               String
  content               String                     @default("")
  coverStorageKey       String?
  coverOriginalName     String?
  coverMimeType         String?
  coverSize             Int?
  mode                  String                     @default("offline")
  location              String
  startsAt              DateTime
  endsAt                DateTime
  registrationOpensAt   DateTime
  registrationClosesAt  DateTime
  capacity              Int
  registeredCount       Int                        @default(0)
  status                String                     @default("draft")
  createdByIssuer       String
  createdBySub          String
  updatedByIssuer       String?
  updatedBySub          String?
  publishedAt           DateTime?
  cancelledAt           DateTime?
  detailsChangedAt      DateTime?
  recapTitle            String?
  recapSummary          String?
  recapContent          String?
  recapPublishedAt      DateTime?
  deletedAt             DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  registrations         ClubActivityRegistration[]
  audits                ClubActivityAudit[]
  recapImages           ClubActivityRecapImage[]
  mcpSources            ClubMcpSource[]

  @@index([status, startsAt])
  @@index([deletedAt])
  @@index([recapPublishedAt, endsAt])
}

model ClubActivityRecapImage {
  id           String       @id @default(uuid())
  activityId   String
  storageKey   String       @unique
  originalName String
  mimeType     String       @default("image/jpeg")
  size         Int
  position     Int
  createdAt    DateTime     @default(now())
  activity     ClubActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([activityId, position])
}

model ClubActivityRegistration {
  id          String       @id @default(uuid())
  activityId  String
  userIssuer  String
  userSub     String
  displayName String?
  status      String       @default("confirmed")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cancelledAt DateTime?
  activity    ClubActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([activityId, userIssuer, userSub])
  @@index([userIssuer, userSub])
}

model ClubActivityAudit {
  id          String       @id @default(uuid())
  activityId  String
  actorIssuer String
  actorSub    String
  action      String
  detailsJson String       @default("{}")
  createdAt   DateTime     @default(now())
  activity    ClubActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([activityId, createdAt])
}

// The operation and its business changes commit in one transaction. A failed
// request leaves neither a pending operation nor a partially completed write.
model ClubMcpOperation {
  id          String   @id @default(uuid())
  actorIssuer String
  actorSub    String
  tool        String
  requestKey  String
  requestHash String
  resultJson  String   @default("")
  createdAt   DateTime @default(now())

  @@unique([actorIssuer, actorSub, tool, requestKey])
  @@index([createdAt])
}

model ClubMcpSource {
  id          String       @id @default(uuid())
  actorIssuer String
  actorSub    String
  sourceKey   String
  sourceUrl   String?
  title       String?
  activityId  String
  createdAt   DateTime     @default(now())
  activity    ClubActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([actorIssuer, actorSub, sourceKey])
  @@index([activityId])
}
