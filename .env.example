# ---------------------------------------------------------------------------
# Database (SQLite for now; PostgreSQL migration is a separate later task)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
PORT=3000

# ---------------------------------------------------------------------------
# Admin credentials for the official-site backend (/api/admin/*)
# ---------------------------------------------------------------------------
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="use-a-long-random-password"

# Logto API Resource used by the member-center permission checks.
# Permissions are requested from this resource and checked from the access-token
# scope: plugin:admin for the plugin market, member:admin for member services.
# The resource is fixed in lib/logto/config.ts as https://cqaiclub.asia/.

# ---------------------------------------------------------------------------
# Logto tenant (member-center identity)
# ---------------------------------------------------------------------------
# Logto endpoint (e.g. https://your-tenant.logto.app)
LOGTO_ENDPOINT=

# Third-party app (Traditional Web) credentials
LOGTO_APP_ID=
LOGTO_APP_SECRET=

# Node runtime mode (usually production in Docker)
NODE_ENV=production

# Public base URLs. baseUrl is the SITE ROOT (no /member suffix) because
# @logto/next builds redirect_uri as `${baseUrl}/member/callback`. Register the
# absolute callback URL in the Logto console, e.g.
#   http://localhost:3000/member/callback   (dev)
#   https://cqaiclub.asia/member/callback   (prod)
BASE_URL_PROD=
BASE_URL_DEV=

# Optional: force social-binding callback base URL
# When set, social redirect_uri will be:
# {SOCIAL_BINDING_CALLBACK_BASE_URL}/member/connections/social/callback?target=...
SOCIAL_BINDING_CALLBACK_BASE_URL=

# Cookie encryption secret (at least 32 characters)
LOGTO_COOKIE_SECRET=

# Machine-to-Machine app credentials (for Management API)
LOGTO_M2M_CLIENT_ID=
LOGTO_M2M_CLIENT_SECRET=

# Optional: Browser tab title (fallbacks to i18n default when empty)
APP_NAME=会员中心

# Runtime config directory (used in dev and Docker)
# Default: deploy
# CONFIG_DIR=deploy
